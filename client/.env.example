# Template only — Vite does NOT read this file. Copy it to client/.env to use it
# locally: `cp client/.env.example client/.env`. On a host (Vercel, Netlify, Render)
# set these in the dashboard instead; both are read at BUILD time, so changing one
# needs a rebuild, not a restart.

# Where the API is. Leave blank for the single-service deploy (Express serves the
# built SPA) and for local dev, where Vite proxies /api and /uploads to port 5050.
# No trailing slash.
VITE_API_URL=https://md-mushikur-rahman-samir.onrender.com

# The site's own origin. Used for og:url and canonical in the baked link-preview
# meta. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL, so it is optional
# there; set it on any other host.
VITE_SITE_URL=https://md-mushikur-rahman-samir.vercel.app
