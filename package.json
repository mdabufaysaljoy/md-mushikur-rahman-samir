{
  "name": "faysal-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "MERN portfolio + CMS admin panel for Md Abu Faysal Joy",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w client",
    "build": "npm run build -w client",
    "seed": "npm run seed -w server",
    "start": "npm run start -w server",
    "export:content": "node scripts/export-content.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
